{
  "name": "@pharmapos/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && ELECTRON_RUN_AS_NODE= ELECTRON_IS_DEV=true electron .",
    "build": "tsc",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "clean": "rm -rf dist release"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "@pharmapos/shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  },
  "build": {
    "appId": "com.pharmapos.desktop",
    "productName": "PharmaPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
